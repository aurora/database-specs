{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://db-specs.invalid/schemas/inventory.schema.json",
  "title": "Feature inventory of one engine version",
  "description": "Generated by `dbspecs inventory` from the engine's own sources (parser grammar at the build commit, reference index of the manual); do not edit. scope/<engine>.yaml classifies every item.",
  "type": "object",
  "required": ["engine", "version", "sources", "items"],
  "additionalProperties": false,
  "properties": {
    "engine": { "$ref": "common.schema.json#/$defs/engineId" },
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "generated_at": { "$ref": "common.schema.json#/$defs/date" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["grammar", "docs-index", "plugins", "server"] },
          "repository": { "type": "string" },
          "commit": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "notes": { "$ref": "common.schema.json#/$defs/notes" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "description": "kw:<KEYWORD> | <parser>:<rule>: <form> | docs:<section>: <entry> | docs-page:<page>: <heading> | buddy:<plugin> | func:<NAME> (built-in function table) | priv:<NAME> | type:<NAME> | opt:<command>: <NAME> | op:<operator>" },
          "kind": { "enum": ["keyword", "grammar", "function", "type", "option", "operator", "privilege", "docs", "plugin"] },
          "parser": { "type": "string" },
          "parsers": { "type": "array", "items": { "type": "string" } },
          "group": { "enum": ["function", "hint", "plpgsql"], "description": "Keywords only: a function-like word or a word of the optimizer-hint parser, not an SQL keyword." },
          "url": { "type": "string" }
        }
      }
    }
  }
}
