{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://db-specs.invalid/schemas/query.schema.json",
  "title": "Query contract",
  "description": "A normalized query (mostly introspection) with one engine/version-specific SQL variant per file. Every variant must return exactly the declared result columns, so consumers can treat all engines the same. SQL files use :name placeholders; consumers translate them to their driver's style (? / $1 / %(name)s).",
  "type": "object",
  "required": ["id", "title", "result", "variants"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
          "type": { "enum": ["string", "integer", "boolean"] },
          "description": { "type": "string" }
        }
      }
    },
    "result": {
      "type": "object",
      "required": ["columns"],
      "additionalProperties": false,
      "properties": {
        "order": { "type": "string" },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "type", "nullable"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
              "type": { "enum": ["string", "integer", "boolean"] },
              "nullable": { "type": "boolean" },
              "enum": { "type": "array", "items": { "type": "string" } },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["engine", "file"],
        "additionalProperties": false,
        "properties": {
          "engine": { "$ref": "common.schema.json#/$defs/engineId" },
          "since": { "$ref": "common.schema.json#/$defs/version" },
          "until": { "$ref": "common.schema.json#/$defs/version" },
          "file": { "type": "string", "pattern": "^[a-z0-9._-]+\\.sql$" },
          "inline_parameters": {
            "description": "Parameters that cannot be placeholders (e.g. DESCRIBE {{table}}): the consumer quotes them per the engine's lexical spec and substitutes {{name}} in the SQL text. All other parameters stay :name placeholders.",
            "type": "object",
            "propertyNames": { "pattern": "^[a-z_][a-z0-9_]*$" },
            "additionalProperties": { "enum": ["identifier", "string-literal"] }
          },
          "transform": {
            "description": "The SQL returns engine-native columns (SHOW / DESCRIBE / PRAGMA output); every contract column is computed per raw row with exactly one rule.",
            "type": "object",
            "propertyNames": { "pattern": "^[a-z_][a-z0-9_]*$" },
            "additionalProperties": { "$ref": "#/$defs/transformRule" }
          },
          "extra_columns": {
            "description": "Engine-specific columns returned after the contract columns (only with transform: copied from a raw column).",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "column"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
                "column": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          },
          "notes": { "$ref": "common.schema.json#/$defs/notes" },
          "sources": { "$ref": "common.schema.json#/$defs/sources" }
        }
      }
    },
    "not_applicable": {
      "description": "Engines that do not have the feature at all (no variant will ever exist), with the reason.",
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/engineId" },
      "additionalProperties": { "type": "string" }
    },
    "gaps": {
      "description": "Known engine/version combinations without a variant yet.",
      "$ref": "common.schema.json#/$defs/notes"
    }
  },
  "$defs": {
    "transformRule": {
      "description": "column: raw value (with map: translated, unmapped values are an error; with equals: boolean value == equals; with contains: boolean, true when the space-separated raw value contains the word). param: a query parameter. const: a fixed value (may be null). row_number: 1-based position of the raw row.",
      "oneOf": [
        {
          "type": "object",
          "required": ["column"],
          "additionalProperties": false,
          "properties": {
            "column": { "type": "string" },
            "map": { "type": "object", "additionalProperties": { "type": ["string", "null"] } },
            "equals": { "type": "string" },
            "contains": { "type": "string" },
            "empty_as_null": { "type": "boolean" }
          }
        },
        {
          "type": "object", "required": ["param"], "additionalProperties": false,
          "properties": { "param": { "type": "string" } }
        },
        {
          "type": "object", "required": ["const"], "additionalProperties": false,
          "properties": { "const": { "type": ["string", "integer", "boolean", "null"] } }
        },
        {
          "type": "object", "required": ["row_number"], "additionalProperties": false,
          "properties": { "row_number": { "const": true } }
        }
      ]
    }
  }
}
