{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://db-specs.invalid/schemas/test.schema.json",
  "title": "Integration test case",
  "description": "Runs against real servers (tests/targets.yaml). Setup is per engine; steps run a query contract or render+execute an operation, then check rows. '{{schema}}' in params is replaced by the target's working schema.",
  "type": "object",
  "required": ["id", "engines", "steps"],
  "additionalProperties": false,
  "$defs": {
    "statements": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["sql"],
            "additionalProperties": false,
            "properties": {
              "sql": { "type": "string" },
              "since": { "$ref": "common.schema.json#/$defs/version" },
              "until": { "$ref": "common.schema.json#/$defs/version" }
            }
          }
        ]
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "row_count": { "type": "integer" },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["match", "values"],
            "additionalProperties": false,
            "properties": {
              "match": { "type": "object" },
              "values": { "type": "object" },
              "engine": { "$ref": "common.schema.json#/$defs/engineId" },
              "since": { "$ref": "common.schema.json#/$defs/version" },
              "until": { "$ref": "common.schema.json#/$defs/version" }
            }
          }
        }
      }
    }
  },
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "description": { "type": "string" },
    "engines": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/engineId" } },
    "setup": {
      "description": "Per engine: SQL strings or {sql, since, until} objects (run only for matching versions).",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/statements" }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/statements" }
    },
    "versions": {
      "description": "Optional version range per engine; targets outside the range are skipped.",
      "type": "object",
      "additionalProperties": { "$ref": "common.schema.json#/$defs/rangeFields" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": { "$ref": "common.schema.json#/$defs/id" },
          "operation": { "$ref": "common.schema.json#/$defs/id" },
          "params": { "type": "object" },
          "params_by_engine": {
            "description": "Per-engine parameters merged over params.",
            "type": "object",
            "additionalProperties": { "type": "object" }
          },
          "expect": { "$ref": "#/$defs/expectation" }
        },
        "oneOf": [{ "required": ["query"] }, { "required": ["operation"] }]
      }
    }
  }
}
