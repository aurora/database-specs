/* PostgreSQL - CREATE INDEX (11 - 18)
   Built-ins: identifier, string_literal, integer, expression.
   Version annotations apply to the item that follows them. */

create_index ::= 'CREATE' 'UNIQUE'? 'INDEX' 'CONCURRENTLY'?
                 ( 'IF' 'NOT' 'EXISTS' identifier | identifier )?
                 'ON' 'ONLY'? table_name ( 'USING' identifier )?
                 '(' index_element ( ',' index_element )* ')'
                 ( 'INCLUDE' '(' identifier ( ',' identifier )* ')' )?
                 /* @since 15 */ ( 'NULLS' 'NOT'? 'DISTINCT' )?
                 ( 'WITH' '(' storage_parameter ( ',' storage_parameter )* ')' )?
                 ( 'TABLESPACE' identifier )?
                 ( 'WHERE' expression )?

table_name ::= identifier ( '.' identifier )?

index_element ::= ( identifier | function_call | '(' expression ')' )
                  ( 'COLLATE' identifier )?
                  ( identifier /* @since 13 */ ( '(' storage_parameter ( ',' storage_parameter )* ')' )? )?
                  ( 'ASC' | 'DESC' )?
                  ( 'NULLS' ( 'FIRST' | 'LAST' ) )?

function_call ::= identifier ( '.' identifier )? '(' ( expression ( ',' expression )* )? ')'

storage_parameter ::= identifier ( '=' ( identifier | integer | string_literal ) )?
