/* Manticore - SELECT with full-text search, grouping and facets (curated subset)
   Built-ins: identifier, string_literal, integer, number.
   The MATCH() argument is its own language: syntax fulltext.manticore-query.
   Not covered: index hints (a hint comment with SecondaryIndex(col) after the statement is a token for the server
   but a comment for this tokenizer - see lexical manticore), sub-selects, table functions,
   KNN / HYBRID_MATCH, LIMIT -n (accepted, but breaks the result: see engine notes). */

select ::= 'SELECT' select_item ( ',' select_item )*
           'FROM' from_target /* @since 28.4 */ table_alias? /* @since 27.1 */ join_clause?
           where_clause?
           group_clause?
           order_clause?
           limit_clause?
           option_clause?
           facet_clause*
         | 'SELECT' select_item ( ',' select_item )* limit_clause?

/* @@system.sessions / @@system.threads: built-in system tables (connections incl. idle ones,
   worker threads). @@system.tables crashes 32.1.3 - see engine notes. */
from_target ::= table_name ( ',' table_name )* | sysvar

/* cluster:table addresses a table of a replication cluster */
table_name ::= ( identifier ':' )? identifier

/* an alias for the FROM table works only as a column prefix in the select list:
   WHERE a.v, ORDER BY a.v and JOIN ON a.id fail, a JOIN table takes no alias */
table_alias ::= 'AS'? identifier

select_item ::= '*' | identifier '.' '*' | select_expr ( 'AS'? identifier )?

/* select-list expressions: arithmetic, bitwise, comparisons and AND / OR / NOT (v > 1 AS c,
   IF(v > 1 AND v < 3, 1, 0)). In the select list (and its function arguments, subscripts) only -
   WHERE takes plain comparisons ('WHERE v + 1 > 5' is a syntax error) */
select_expr ::= bool_term ( 'OR' bool_term )*
bool_term ::= bool_factor ( 'AND' bool_factor )*
bool_factor ::= 'NOT'? arith_expr ( comparison_operator arith_expr )?
arith_expr ::= '-'? arith_operand ( arith_operator '-'? arith_operand )*
arith_operand ::= '(' select_expr ')' | expr_call | value_expr
arith_operator ::= '+' | '-' | '*' | '/' | '%' | '&' | '|' | 'DIV' | 'MOD'

/* function call with expression arguments (select list only) */
expr_call ::= identifier '(' ( '*' | select_expr ( ',' select_expr )* )? ')'

/* MATCH() items belong to the top-level AND chain only (not in OR, not under NOT; parentheses
   only around a single MATCH). Several MATCH items need a JOIN: one per table, named by the
   second argument; two for the same table are a semantic error ('too many MATCH() clauses').
   The condition after the last MATCH item may contain OR - it binds as a whole:
   MATCH('a') AND x = 1 OR y = 2 means MATCH('a') AND (x = 1 OR y = 2), not SQL precedence. */
where_clause ::= 'WHERE' ( condition_term 'AND' )? match_group ( 'AND' condition_term 'AND' match_group )? ( 'AND' condition )?
               | 'WHERE' condition

match_group ::= match_item ( 'AND' match_item )*

match_item ::= ( match_call | '(' match_call ')' ) ( 'AS' identifier )?

match_call ::= 'MATCH' '(' string_literal ( ',' identifier )? ')'

/* one JOIN at most; without INNER / LEFT it is an inner join */
join_clause ::= ( 'INNER' | 'LEFT' )? 'JOIN' identifier 'ON' join_condition ( 'AND' join_condition )*

join_condition ::= join_operand '=' join_operand

/* casts like int(t.json.key) / string(...) work on JSON attributes only */
join_operand ::= column_ref | identifier '(' column_ref ')'

condition ::= condition_term ( 'OR' condition_term )*
condition_term ::= condition_factor ( 'AND' condition_factor )*
condition_factor ::= 'NOT'? ( '(' condition ')' | predicate )

predicate ::= value_expr ( comparison_operator value_expr
                         | 'NOT'? 'IN' '(' literal ( ',' literal )* ')'
                         | 'NOT'? 'IN' '@' identifier
                         | 'NOT'? ( 'ANY' | 'ALL' ) '(' string_literal ( ',' string_literal )* ')'
                         | 'NOT'? 'BETWEEN' literal 'AND' literal
                         | 'IS' 'NOT'? 'NULL' )
            | function_call

comparison_operator ::= '=' | '!=' | '<>' | '<' | '<=' | '>' | '>='

value_expr ::= function_call | column_ref | literal | sysvar | 'FACET' '(' ')' | mva_aggr

/* ANY(mva) = 2, ALL(mva) > 1 */
mva_aggr ::= ( 'ANY' | 'ALL' ) '(' column_ref ')'

/* table.column, json.path.keys and json['key'] / json[0] */
column_ref ::= identifier ( '.' identifier | '[' ( string_literal | arith_expr ) ']' )*

sysvar ::= '@' '@' identifier ( '.' identifier )*

/* WEIGHT(), COUNT(*), ANY(mva), HIGHLIGHT(), GROUPBY(), ... */
function_call ::= identifier '(' ( '*' | value_expr ( ',' value_expr )* )? ')'

literal ::= string_literal | '-'? number

/* GROUP n BY: up to n rows per group; WITHIN GROUP ORDER BY picks which rows.
   HAVING takes a single predicate (no AND / OR). */
/* GROUP BY takes columns, JSON paths (meta.a.b; missing keys form a NULL group) and MVAs */
group_clause ::= 'GROUP' integer? 'BY' column_ref ( ',' column_ref )*
                 ( 'WITHIN' 'GROUP' 'ORDER' 'BY' order_list )?
                 ( 'HAVING' predicate )?

order_clause ::= 'ORDER' 'BY' order_list

/* the server parses the sort list as name / direction pairs: every item needs ASC or DESC
   ('no sort order defined', 'invalid sorting order'), except the last of two or more */
order_list ::= order_item ( ',' order_item )* ( ',' value_expr )?
order_item ::= value_expr ( 'ASC' | 'DESC' )

/* a FACET may also sort by a single item without direction */
facet_order_clause ::= 'ORDER' 'BY' ( order_list | value_expr )

limit_clause ::= 'LIMIT' integer ( ( ',' | 'OFFSET' ) integer )?

option_clause ::= 'OPTION' option ( ',' option )*
/* field_weights = (title = 10, body = 1), ranker = expr('sum(lcs) * 1000 + bm25'), max_matches = 2000 */
option ::= identifier '=' ( '(' named_value ( ',' named_value )* ')' | identifier ( '(' string_literal ')' )? | literal )
named_value ::= identifier '=' literal

/* each FACET returns an extra result set: the facet values with count(*) */
facet_clause ::= 'FACET' facet_item ( ',' facet_item )*
                 ( 'BY' facet_item ( ',' facet_item )* )?
                 /* @since 27.1 */ ( 'ALL' 'FILTERS' | 'EXCLUDE'? 'FILTERS' identifier ( ',' identifier )* )?
                 /* @since 28.4 */ 'ZEROES'?
                 /* @since 27.1 */ ( 'MODE' identifier )?
                 ( 'DISTINCT' identifier? )?
                 facet_order_clause?
                 limit_clause?

/* FACET brand, FACET INTERVAL(price, 200, 400) AS range */
facet_item ::= value_expr ( 'AS' identifier )?
